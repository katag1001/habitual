{
  "expo": {
    "name": "habitual",
    "slug": "habitual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.habitual.app",
      "adaptiveIcon": {
        "backgroundColor": "#F0C3C6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FBE3E1"
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "habitual",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#FBE3E1",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8ec83969-fced-4064-9eb7-f870208c90db"
      }
    }
  }
}
